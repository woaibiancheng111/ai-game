{
  "name": "ai-campus-survival-simulator",
  "version": "1.0.0",
  "description": "AI 校园生存模拟器 - Campus Survival Simulator",
  "author": "AI Campus Survival Team",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && electron-builder",
    "build:dir": "tsc && vite build && electron-builder --dir",
    "build:vite": "tsc && vite build",
    "dist:win": "tsc && vite build && electron-builder --win --x64",
    "preview": "vite preview",
    "electron:dev": "vite build && electron .",
    "typecheck": "tsc --noEmit",
    "validate:story": "node scripts/validate-story.mjs",
    "route:smoke": "node scripts/route-smoke.mjs",
    "test:e2e:smoke": "npm run build:vite && node scripts/e2e-smoke.mjs",
    "release:verify": "node scripts/release-verify.mjs",
    "release:manifest": "node scripts/release-manifest.mjs",
    "release:win": "npm run release:verify && npm run dist:win && npm run release:manifest",
    "ai-proxy:dev": "node server/ai-proxy/server.mjs"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "electron-store": "^10.0.0",
    "mysql2": "^3.22.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "typescript": "^5.6.2",
    "vite": "^6.0.5",
    "vite-plugin-electron": "^0.28.8",
    "vite-plugin-electron-renderer": "^0.14.6"
  },
  "build": {
    "appId": "com.ai-game.campus-survival-simulator",
    "productName": "AI校园生存模拟器",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "win": {
      "icon": "public/icons/icon-512.png",
      "sign": false,
      "signAndEditExecutable": false,
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.education"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Education"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
