# ==========================================
# AI 校园生存模拟器 环境配置模板
# 复制此文件并重命名为 .env 然后修改对应配置
# ==========================================

# -----------------
# AI 商业代理配置（可选）
# -----------------
# 商业桌面版默认可以离线游玩。配置代理后，NPC 对话会优先走服务端代理增强。
# 本地调试可先运行 npm run ai-proxy:dev，再把客户端代理地址设为 http://localhost:8787/chat。
AI_PROXY_URL=http://localhost:8787/chat

# 以下变量只放在代理服务所在机器，不要打包进客户端安装包。
AI_PROXY_PORT=8787
AI_PROVIDER_URL=https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions
AI_PROVIDER_API_KEY=your_provider_api_key_here
AI_PROXY_MODEL=qwen-plus

# 兼容旧版本地开发：如需直接调 DashScope，可保留以下变量；商业版建议使用 AI_PROXY_URL + 服务端代理。
VITE_DASHSCOPE_API_KEY=your_dashscope_api_key_here

# -----------------
# MySQL 数据库配置
# -----------------
# 用于持久化存储玩家账号、存档和成就等信息。
# 如果不配置或连接失败，游戏会自动降级为无数据库的纯本地运行模式。

MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=ai_campus_survival
MYSQL_USER=root
MYSQL_PASSWORD=123456
